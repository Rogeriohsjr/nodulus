{
  "$id": "file-changes.v1",
  "type": "object",
  "properties": {
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "enum": [
              "src/adapters/providers/captured-process.ts"
            ]
          },
          "content": {
            "type": "string"
          },
          "edits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "old": {
                  "type": "string",
                  "minLength": 1
                },
                "new": {
                  "type": "string"
                }
              },
              "required": [
                "old",
                "new"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "content"
            ]
          },
          {
            "required": [
              "edits"
            ]
          }
        ]
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "files",
    "summary"
  ],
  "additionalProperties": false
}
