{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev-work.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "summary",
    "changedFiles",
    "validation"
  ]
}
